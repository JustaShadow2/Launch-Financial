generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Optional direct (non-pooled) connection used for migrations. On Neon, set
  // this to the direct connection string; falls back to DATABASE_URL if unset.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime  @default(now())

  // Learning / gamification state (Duolingo-style).
  xp            Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  // The date (YYYY-MM-DD) the user last completed a lesson, for streak logic.
  lastLessonDay String?

  // Streak freezes: a consumable that auto-protects the streak on a missed day
  // (Duolingo mechanic). Users hold a small number and earn more at streak
  // milestones. `freezeLastEarnedDay` prevents earning more than once per day.
  streakFreezes       Int     @default(0)
  freezeLastEarnedDay String?
  // The day (YYYY-MM-DD) a freeze was last auto-consumed, so the UI can tell
  // the user "a freeze saved your streak".
  freezeUsedDay       String?

  accounts     Account[]
  watchlist    WatchlistItem[]
  lessonProgress LessonProgress[]
  coachMessages  CoachMessage[]
  itemMemories   ItemMemory[]
}

// A single message in the user's AI Coach conversation. Persisted so the chat
// survives refreshes and follows the user across devices. Storage is kept flat
// by pruning to the most recent N messages per user on write (see the coach
// service). Content is small text; cost is negligible.
model CoachMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Per-user completion record for a lesson. Content itself is static (see
// data/learningContent.ts); only progress is persisted here.
model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  lessonId    String
  completedAt DateTime @default(now())
  // Score on the most recent completion, e.g. 3 correct of 3.
  correct     Int      @default(0)
  total       Int      @default(0)
  xpEarned    Int      @default(0)
  // Crown level (0..5, Duolingo mechanic). Each level makes the node's session
  // tougher (more items, harder interleaving). 0 means completed but not yet
  // leveled; a first completion sets it to 1.
  crownLevel  Int      @default(0)

  @@unique([userId, lessonId])
  @@index([userId])
}

// Per-user spaced-repetition memory state for a single quiz item (question).
// Implements the Half-Life Regression (HLM) model: we estimate a half-life
// `halfLife` (in hours) for how long the user retains this item, and compute a
// recall probability p = 2^(-elapsed/halfLife). When p drops below a threshold
// the item becomes "overdue" and is prioritized into the next review session.
// Keyed by (userId, itemId); itemId is the stable question id (e.g. "gs-1-q1").
model ItemMemory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId       String   // stable question id, e.g. "gs-1-q1"
  lessonId     String   // owning lesson, for lesson-scoped review
  courseId     String
  // HLM state.
  halfLifeHours Float   @default(24) // estimated retention half-life in hours
  lastReviewed  DateTime @default(now())
  timesSeen     Int     @default(0)
  timesCorrect  Int     @default(0)
  timesWrong    Int     @default(0)
  // Consecutive correct answers — drives half-life growth.
  streak        Int     @default(0)

  @@unique([userId, itemId])
  @@index([userId, lessonId])
  @@index([userId])
}

// An investing account (e.g. Personal / TFSA / RRSP). Each holds cash + positions.
model Account {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String    // PERSONAL, TFSA, RRSP, CRYPTO
  name         String
  cashBalance  Float     @default(0)
  createdAt    DateTime  @default(now())

  holdings     Holding[]
  transactions Transaction[]
  orders       Order[]

  @@index([userId])
}

// A position in a symbol within an account.
model Holding {
  id           String    @id @default(cuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol       String
  quantity     Float     @default(0)
  avgCost      Float     @default(0) // average cost basis per share
  updatedAt    DateTime  @updatedAt

  @@unique([accountId, symbol])
  @@index([accountId])
}

// Cash ledger + trade ledger entries.
model Transaction {
  id           String    @id @default(cuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type         String    // DEPOSIT, WITHDRAWAL, BUY, SELL
  symbol       String?
  quantity     Float?
  price        Float?
  amount       Float     // signed cash impact (+ increases cash, - decreases cash)
  note         String?
  createdAt    DateTime  @default(now())

  @@index([accountId])
}

// Order record (market orders execute immediately in simulation).
model Order {
  id           String    @id @default(cuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol       String
  side         String    // BUY, SELL
  type         String    // MARKET
  quantity     Float
  status       String    // FILLED, REJECTED
  filledPrice  Float?
  createdAt    DateTime  @default(now())

  @@index([accountId])
}

model WatchlistItem {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol       String
  createdAt    DateTime  @default(now())

  @@unique([userId, symbol])
  @@index([userId])
}

// One-time password codes for the "forgot password" flow. The code is stored
// hashed (never in plaintext). A row is consumed on successful reset and
// expires after a short window; attempts are capped to prevent brute force.
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String   // lowercased email the code was issued for
  codeHash  String   // bcrypt hash of the 6-digit OTP
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// Cached metadata for any symbol we've resolved via a data provider. Because
// symbols are now searched dynamically (no static universe), this table is the
// source of truth for a symbol's display name and asset type at render time
// (portfolio positions, watchlist rows) without needing a live search.
model SymbolMeta {
  symbol      String   @id
  name        String
  assetType   String   // STOCK, ETF, CRYPTO
  updatedAt   DateTime @updatedAt
}
