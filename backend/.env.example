# Copy to .env and fill in. Do NOT commit real secrets (.env is gitignored).

# Postgres (Neon). Use the POOLED connection string for the app:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Optional: Neon DIRECT (non-pooled) connection string, used for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4137

# Market data providers
FINNHUB_API_KEY=""        # symbol search + stock/ETF quotes (finnhub.io)
TWELVE_DATA_API_KEY=""    # crypto quotes + historical charts (twelvedata.com)

# Email for password-reset codes (optional). Uses Resend (resend.com).
# If RESEND_API_KEY is unset, reset codes are logged to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Launch Financial <onboarding@resend.dev>"

# Learning coach chatbot via Groq (console.groq.com). Same key as AI-Chef.
# If GROQ_API_KEY is unset, the Coach tab shows as unavailable.
# GROQ_MODEL is OPTIONAL — leave it blank and the app auto-discovers an
# available chat model from Groq's /models endpoint (with fallback). Only set
# it to pin a specific model.
GROQ_API_KEY=""
GROQ_MODEL=""

# Refresh cadences (ms)
QUOTE_REFRESH_MS=15000
CRYPTO_REFRESH_MS=30000
HISTORY_CACHE_MS=3600000
